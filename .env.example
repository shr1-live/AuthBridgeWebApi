# Backend configuration shape. Never commit a filled copy.
# In Render these are environment variables (see render.yaml); secrets are marked sync: false
# and entered in the dashboard. The frontend never receives any of these.

# Required, explicit: SqlServer (local Windows, LocalDB) or Postgres (deployment target).
Database__Provider=SqlServer
# LocalDB for development. For Render: the Supabase connection string for the restricted
# runtime role (db/postgres/runtime-role.sql), copied from the real project - never guessed.
Database__ConnectionString=Server=(localdb)\MSSQLLocalDB;Database=AuthBridge;Trusted_Connection=True;TrustServerCertificate=True

# Supabase for any deployment. LocalDev is for Development/Testing only; startup refuses it
# in every other environment.
Auth__Mode=Supabase
Auth__Supabase__Issuer=https://<project-ref>.supabase.co/auth/v1
Auth__Supabase__JwksUri=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
Auth__Supabase__Audience=authenticated

# Exact origins, never a wildcard (startup fails on one).
Cors__AllowedOrigins__0=http://localhost:4200
# Base URL that proposal review links point to (the Angular app).
Workflow__ReviewUrlBase=http://localhost:4200

# Operator tool only (DbTool migrate/seed/import): owner credentials. Never set in Render.
AUTHBRIDGE_MIGRATION_CONNECTION=

# Integration tests, optional: otherwise LocalDB (Windows) and Testcontainers are used.
AUTHBRIDGE_TEST_SQLSERVER=
AUTHBRIDGE_TEST_POSTGRES=

# Local stdio MCP host, Development only: the seeded subject it acts as. The default lives in
# src/AuthBridge.Mcp/mcpsettings.Development.json.
Mcp__LocalUserSubject=
