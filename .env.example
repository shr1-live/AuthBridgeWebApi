# Copy to .env and fill in locally. Never commit the filled copy.
# Production values live only in Render's secret store.

# SqlServer (local Windows development) or Postgres (deployment target).
Database__Provider=SqlServer

# LocalDB for development. The deployment connection string comes from the
# user's own Supabase project and is not guessed or constructed here.
Database__ConnectionString=Server=(localdb)\MSSQLLocalDB;Database=AuthBridge;Trusted_Connection=True;TrustServerCertificate=True

# Supabase Auth. The backend validates tokens; it never issues them.
# Values come from the real project - see docs/ENVIRONMENT.md for why these
# are absent.
Supabase__Issuer=
Supabase__Audience=authenticated
Supabase__JwksUri=

# Exact origins, never a wildcard.
Cors__AllowedOrigins__0=http://localhost:4200

# Development only. Binds the local stdio MCP host to one seeded user subject.
# Must stay unset in any deployed environment.
Mcp__LocalUserSubject=
