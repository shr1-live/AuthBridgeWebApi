<Project Sdk="Microsoft.NET.Sdk">

  <!-- Local stdio MCP host. The tool class is also referenced by AuthBridge.Api for the
       hosted /mcp endpoint, so both transports expose the identical eight tools. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <StartupObject>AuthBridge.Mcp.StdioHost</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuthBridge.Infrastructure\AuthBridge.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <!-- Named mcpsettings*.json so they never collide with the API host's appsettings when the
         API references this project for the shared tool class. -->
    <None Include="mcpsettings*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
